<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard-Formular zur Wochen-Konfiguration -->
    <record id="view_event_week_config_form" model="ir.ui.view">
        <field name="name">event.week.config.form</field>
        <field name="model">event.week.config</field>
        <field name="arch" type="xml">
            <form string="Wochen-Veranstaltung erstellen">
                <group>
                    <field name="week_start" />
                    <field name="week_template_id" />
                    <button name="action_load_week_template" type="object"
                            string="Template laden" class="btn-primary"
                            invisible="week_template_id == False"/>
                </group>
                <group>
                    <field name="line_ids">
                        <kanban default_group_by="weekday" >
                            <field name="name"/>
                            <field name="event_template_id"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="weekday"/>


                            <templates>
                                <t t-name="card">
                                    <div class="oe_kanban_card">
                                        <strong><t t-esc="record.name.value"/></strong>
                                        <div>Vorlage: <t t-esc="record.event_template_id.value"/></div>
                                        <div>Start: <t t-esc="record.start_datetime.value"/></div>
                                        <div>Ende: <t t-esc="record.end_datetime.value"/></div>
                                    </div>
                                </t>
                                <t t-name="kanban-group">
                                    <div class="oe_kanban_group">
                                        <strong>
                                            <t t-if="group.value == 0">Montag</t>
                                            <t t-if="group.value == 1">Dienstag</t>
                                            <t t-if="group.value == 2">Mittwoch</t>
                                            <t t-if="group.value == 3">Donnerstag</t>
                                            <t t-if="group.value == 4">Freitag</t>
                                            <t t-if="group.value == 5">Samstag</t>
                                            <t t-if="group.value == 6">Sonntag</t>
                                        </strong>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </group>
                <footer>
                    <button string="Erstellen" type="object" name="action_create_events" class="btn-primary"/>
                    <button string="Abbrechen" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>



    <!-- Wizard-Aktion -->
    <record id="action_event_week_config" model="ir.actions.act_window">
        <field name="name">Wochen-Veranstaltung erstellen</field>
        <field name="res_model">event.week.config</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>
