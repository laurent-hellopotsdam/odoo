<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulardarstellung für das Wochen-Template -->
    <record id="view_event_week_template_form" model="ir.ui.view">
        <field name="name">event.week.template.form</field>
        <field name="model">event.week.template</field>
        <field name="arch" type="xml">
            <form string="Wochen-Template">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Zeitslots">
                            <field name="week_line_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="day_of_week"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="event_template_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Listenansicht für Wochen-Templates -->
    <record id="view_event_week_template_tree" model="ir.ui.view">
        <field name="name">event.week.template.tree</field>
        <field name="model">event.week.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Aktion und Menüpunkt für Wochen-Templates -->
    <record id="action_event_week_template" model="ir.actions.act_window">
        <field name="name">Wochen-Templates</field>
        <field name="res_model">event.week.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_event_week_template"
              name="Wochen-Templates"
              parent="event.menu_event_root"
              action="action_event_week_template"/>
</odoo>
