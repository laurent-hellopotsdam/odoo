<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulardarstellung für das Wochen-Template -->
    <record id="view_event_week_template_form" model="ir.ui.view">
        <field name="name">event.week.template.form</field>
        <field name="model">event.week.template</field>
        <field name="arch" type="xml">
            <form string="Wochen-Template">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Zeitslots">
                            <field name="week_line_ids">
                                 <kanban default_group_by="day_of_week" >
                                    <field name="name"/>
                                    <field name="event_template_id"/>
                                    <field name="start_time" widget="float_time" />
                                    <field name="end_time" widget="float_time"/>
                                    <field name="day_of_week" widget="selection"/>


                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_card">
                                                <strong><t t-esc="record.name.value"/></strong>
                                                <div>Vorlage: <t t-esc="record.event_template_id.value"/></div>
                                                <div>Start: <t t-esc="record.start_time.value"/></div>
                                                <div>Ende: <t t-esc="record.end_time.value"/></div>
                                            </div>
                                        </t>
                                        <t t-name="kanban-group">
                                            <div class="oe_kanban_group">
                                                <strong>
                                                    <t t-if="group.value == 0">Montag</t>
                                                    <t t-if="group.value == 1">Dienstag</t>
                                                    <t t-if="group.value == 2">Mittwoch</t>
                                                    <t t-if="group.value == 3">Donnerstag</t>
                                                    <t t-if="group.value == 4">Freitag</t>
                                                    <t t-if="group.value == 5">Samstag</t>
                                                    <t t-if="group.value == 6">Sonntag</t>
                                                </strong>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Listenansicht für Wochen-Templates -->
    <record id="view_event_week_template_list" model="ir.ui.view">
        <field name="name">event.week.template.list</field>
        <field name="model">event.week.template</field>
        <field name="arch" type="xml">
            <list string="Wochen-Template Liste">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Aktion und Menüpunkt für Wochen-Templates -->
    <record id="action_event_week_template" model="ir.actions.act_window">
        <field name="name">Wochen-Templates</field>
        <field name="res_model">event.week.template</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
